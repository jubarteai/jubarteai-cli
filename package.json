{
  "name": "jubarteai",
  "version": "0.1.1",
  "description": "Command-line interface for JubarteAI, the agentic connection platform.",
  "license": "MIT",
  "author": "A&A GLOBAL INTERNATIONAL LLC",
  "type": "module",
  "bin": {
    "jubarteai": "bin/jubarteai.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubarteai/jubarteai-cli.git"
  },
  "homepage": "https://github.com/jubarteai/jubarteai-cli#readme",
  "bugs": {
    "url": "https://github.com/jubarteai/jubarteai-cli/issues"
  },
  "keywords": [
    "jubarteai",
    "mcp",
    "cli",
    "agents",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "node-pty": "1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
